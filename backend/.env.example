# ── VADER Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | production | test
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info            # debug | info | warning | error | critical

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Active provider: groq | gemini | mock
# Use "mock" for local development without real API keys.
LLM_PROVIDER=mock

# ─── LLM Parameters ───────────────────────────────────────────────────────────
# These values are validated against the chosen provider's supported models.
# Set to an empty string to use each provider's default.
LLM_MODEL_ID=
GROQ_MODEL_ID=openai/gpt-oss-120b
GEMINI_MODEL_ID=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ─── Agent-Specific Provider & Model Overrides ─────────────────────────────────
# When LLM_PROVIDER is not "mock", VADER uses the target hybrid configuration:
#   - Planner:    groq   / openai/gpt-oss-120b
#   - Executor A: groq   / openai/gpt-oss-120b
#   - Executor B: gemini / gemini-3.5-flash-lite
#   - Critic:     gemini / gemini-3.5-flash-lite
#   - Judge:      groq   / openai/gpt-oss-120b
# You can optionally customize individual agents below (groq | gemini | mock):
# PLANNER_PROVIDER=groq
# PLANNER_MODEL_ID=openai/gpt-oss-120b
# EXECUTOR_A_PROVIDER=groq
# EXECUTOR_A_MODEL_ID=openai/gpt-oss-120b
# EXECUTOR_B_PROVIDER=gemini
# EXECUTOR_B_MODEL_ID=gemini-3.5-flash-lite
# CRITIC_PROVIDER=gemini
# CRITIC_MODEL_ID=gemini-3.5-flash-lite
# JUDGE_PROVIDER=groq
# JUDGE_MODEL_ID=openai/gpt-oss-120b

# ─── Debate Orchestrator ───────────────────────────────────────────────────────
DEBATE_MAX_ROUNDS=3
DEBATE_SIMILARITY_THRESHOLD=0.92  # cosine similarity convergence signal (0‒1)

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_ENABLED=true

# ─── Search / Retrieval ────────────────────────────────────────────────────────
# DuckDuckGo search is used by default (no key required).
# Uncomment and set if you want SerpAPI instead.
# SERPAPI_API_KEY=your-serpapi-key-here
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10
